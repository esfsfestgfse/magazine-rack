{
  "name": "magazine-rack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A discovery-first public periodicals reading room.",
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/check-api.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "api:dev": "wrangler dev --config apps/api/wrangler.jsonc",
    "api:deploy": "wrangler deploy --config apps/api/wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.128.0"
  }
}
